# ── 필수 환경변수 ──────────────────────────────────────────────
# Vercel 배포 시: Settings > Environment Variables에 추가
# 로컬 실행 시: 이 파일을 .env로 복사 후 값 입력

# OpenAI - 임베딩 생성용
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Pinecone - 벡터 DB
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=semiconductor-lithography

# Anthropic Claude - 챗봇 응답 생성용
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ── 선택 환경변수 ──────────────────────────────────────────────

# Google Gemini - Claude/OpenAI 폴백용 (선택)
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM 폴백 (llm-fallback-hardening) ──────────────────────────
# 전부 선택 — 미설정 시 app/config.py 기본값으로 동작한다.
#
# 장애 시 무배포 롤백 수단:
# ANSWER_PROVIDER=openai         # 답변 1순위 제공자 고정 (claude|openai|gemini).
#                                # 미설정 시 Claude → OpenAI → Gemini 순.
# OPENAI_CHAT_MODEL=o3           # 답변·인용 교정의 OpenAI 모델 (A/B 비교용)
# GEMINI_MODEL=gemini-pro-latest # 3순위 모델. 별칭이라 EOL을 자동 추종한다 —
#                                # 고정 버전을 넣으면 모델 폐기 시 조용히 404가 된다
#
# 타임아웃·재시도 예산 (docs/02-design/features/llm-fallback-hardening.design.md §3.4):
# ANSWER_READ_TIMEOUT=20         # 답변 제공자별 read 타임아웃(초).
#                                # 이 값 × 제공자 수가 프론트 idle 60초 안에 들어와야 한다
# ANSWER_MAX_RETRIES=0           # 답변 경로 재시도. 동일 벤더 재시도보다 전환이 빠르다.
#                                # **상한 1로 클램프된다** — 하트비트는 벤더 전환 시점에만
#                                # 나가므로 2회 재시도(75초)는 프론트 idle 60초를 넘긴다
# CITATION_STAGE_BUDGET=45       # 인용 교정 단계 전체 상한(초). **상한 45로 클램프된다** —
#                                # 교정 중에는 하트비트를 낼 수 없어 이 값이 곧 무이벤트 구간이다
#
# 의도분석 교차벤더 폴백 (Anthropic 장애 시 계산기·스코프 게이트 생존):
# INTENT_FALLBACK_ENABLED=true   # false로 두면 Claude 실패 시 즉시 레거시 경로로 강등
# INTENT_FALLBACK_MODEL=gpt-4.1  # 비추론 모델 권장 — 추론 모델은 reasoning 토큰이
#                                # 한도를 잠식해 tool_call이 빈 채로 끊길 수 있다

# Supabase - Q&A 저장용
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase service_role 키 - purge_storage_orphans.py 전용(배치 실행자만).
# anon 키는 storage.objects에 DELETE 정책이 없어 파기 스크립트가 동작하지 않는다.
# 절대 브라우저로 전달하지 말 것 — 서버·로컬 배치 환경에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 법제처 국가법령정보 Open API - 실시간 법조문·판례 조회용 (선택)
ODCLOUD_API_KEY=your_odcloud_api_key_here
LAW_API_KEY=your_law_api_key_here
# LAW_API_SEARCH_TIMEOUT=3       # 검색 API 타임아웃(초), 기본 3초
# LAW_API_SERVICE_TIMEOUT=8      # 조문 조회 API 타임아웃(초), 기본 8초
# LAW_API_CACHE_TTL=86400        # L1 캐시 유효시간(초), 기본 24시간
# Supabase 설정 시 법조문 캐시가 L2(Supabase)에 7일간 영속 저장됨


# Cohere - Rerank 검색 결과 재정렬용 (선택)
COHERE_API_KEY=your_cohere_api_key_here

# 관리자 페이지 - /admin 접속용 비밀번호
ADMIN_PASSWORD=your_admin_password_here
# ADMIN_JWT_SECRET=별도_JWT_시크릿 (미설정 시 ADMIN_PASSWORD 사용)

# ── 챗봇 남용 가드 (chatbot-security) ──────────────────────────
# 전부 선택 — 미설정 시 아래 기본값으로 동작한다.
# Supabase 스키마 선행 필요: supabase_abuse_guard.sql 실행
# MAX_MESSAGE_LENGTH=2000        # 질문 최대 길이(자)
# CHAT_RATE_LIMIT=5              # IP당 요청 수
# CHAT_RATE_WINDOW=60            # rate limit 윈도우(초). 인메모리 =
#                                # Vercel 인스턴스별 베스트에포트(총량은 아래 쿼터가 담당)
# DAILY_CHAT_QUOTA=50            # IP당 일일 상한 (Supabase 공유 카운터)
# ABUSE_GUARD_MODE=monitor       # off|monitor|block — 프롬프트 인젝션 가드
# INJECTION_BLOCK_THRESHOLD=3    # 인젝션 점수 임계
# SCOPE_GATE_MODE=monitor        # off|monitor|block — 노동법 외 질문 차단
# ABUSE_BLOCK_WINDOW=300         # 자동 차단 판정 윈도우(초)
# ABUSE_BLOCK_THRESHOLD=10       # 윈도우 내 위반 누적 임계
# ABUSE_BLOCK_MINUTES=30         # 자동 차단 지속(분)
#
# ⚠️ 초기 배포는 monitor로 두고 1주간 /api/admin/abuse 로그를 검토한 뒤 block 전환.
#    monitor는 판정을 기록만 하고 답변은 정상 제공한다(오탐 관측용).

# CORS 허용 오리진 (쉼표 구분). 미설정 시 "*" — 타 사이트의 무료 프록시 임베드를
# 막으려면 실제 도메인으로 제한할 것.
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-id.github.io

# ── 검증 ──────────────────────────────────────────────────────
# python3 check_env.py  — 배포 전 환경변수 검증
